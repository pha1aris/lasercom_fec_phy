xczu15eg-ffvb1156-2-i
# ==============================================================================
# 函数：准备 Run (不设置 TOP，只创建对象)
# ==============================================================================
proc prepare_run_obj {run_prefix base_s base_i flow_s flow_i part} {
    set s_run "synth_${run_prefix}"
    set i_run "impl_${run_prefix}"

    if {[get_runs -quiet $s_run] == ""} {
        puts " -> 创建综合 Run: $s_run"
        create_run $s_run -flow $flow_s -part $part
    }
    
    if {[get_runs -quiet $i_run] == ""} {
        puts " -> 创建实现 Run: $i_run"
        create_run $i_run -parent_run $s_run -flow $flow_i -part $part
    }
    return $i_run
}
# 1. 准备运行对象
set tx_impl_run [prepare_run_obj "tx" $base_synth $base_impl $flow_synth $flow_impl $part_name]
impl_tx
set rx_impl_run [prepare_run_obj "rx" $base_synth $base_impl $flow_synth $flow_impl $part_name]
impl_rx

    # 2. 执行导入操作
    # -force 参数确保如果工程目录下有同名文件则覆盖
    # import_files 会自动处理 Design Sources, Simulation Sources 和 Constraints
    import_files -force
    
    puts "文件导入操作完成。"
    puts "------------------------------------------------"
    
    # 3. 验证检查
    # 获取所有源文件
    set all_files [get_files]
    set remote_count 0
    
    # 获取工程目录路径
    set proj_dir [get_property DIRECTORY [current_project]]
    
    foreach f $all_files {
        # 检查文件路径是否包含工程路径
        # 注意：这里做简单的字符串匹配检查
        if {[string first $proj_dir $f] == -1} {
            # 排除掉 Xilinx IP核文件，因为它们本来就可能在外面，或者是指向IP库的
            if {[string match "*.xci" $f] == 0} {
                puts "【警告】文件似乎仍在工程外部: $f"
                incr remote_count
            }
        }
    }
    
    if {$remote_count == 0} {
        puts "【成功】所有源文件现已包含在工程文件夹内！"
    } else {
        puts "【注意】仍有 $remote_count 个文件可能未被复制，请检查是否为IP核或系统库文件。"
    }
    puts "------------------------------------------------"
}

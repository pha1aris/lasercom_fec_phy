    }
    
    # 排除已经在目标目录下的文件
    set f_normalized [file normalize $f]
    set new_src_dir_normalized [file normalize $new_src_dir]
    if {[string first $new_src_dir_normalized $f_normalized] != -1} {
        continue
    }

    # --- 执行移动逻辑 ---
    set new_file_path [file join $new_src_dir $fname]
    
    puts " -> 处理: $fname"
    
    # A. 物理复制文件
    # 使用 -force 覆盖旧文件（如果有）
    if {[catch {file copy -force $f $new_file_path} err]} {
        puts "    [错误] 无法复制文件: $err"
        continue
    }
    
    # B. 从工程中移除旧引用
    remove_files $f
    
    # C. 添加新文件引用
    # -norecurse: 不递归扫描子目录
    # -scan_for_includes: 扫描头文件包含
    add_files -norecurse -scan_for_includes $new_file_path
    
    incr move_count
}

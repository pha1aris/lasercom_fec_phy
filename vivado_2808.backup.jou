# ==============================================================================
# 约束文件(.xdc) 整理脚本
# ==============================================================================
set target_folder_name "constraints"
set proj_dir [get_property DIRECTORY [current_project]]
set new_xdc_dir [file join $proj_dir $target_folder_name]
# 1. 创建文件夹
if {![file exists $new_xdc_dir]} {
    file mkdir $new_xdc_dir
}
# 2. 移动 XDC 文件
foreach f [get_files -of_objects [get_filesets constrs_1]] {
    # 只处理 .xdc 文件，且排除 IP 核生成的 (ooc/board/clocks)
    if {[string match "*.xdc" $f] && ![string match "*ooc.xdc" $f] && ![string match "*clocks.xdc" $f] && ![string match "*board.xdc" $f]} {
        
        set fname [file tail $f]
        set new_file_path [file join $new_xdc_dir $fname]
        
        puts " -> 正在移动约束文件: $fname"
        
        # 复制 & 移除旧引用 & 添加新引用
        if {[catch {file copy -force $f $new_file_path} err]} {
            puts "    [错误] 复制失败: $err"
        } else {
            remove_files $f
            add_files -fileset constrs_1 -norecurse $new_file_path
            puts "    [成功] 已移动到 /constraints 目录"
        }
    }
}

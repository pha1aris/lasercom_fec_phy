# ==============================================================================
# Vivado 工程源文件目录结构重构脚本
# 功能：将散乱或深层嵌套的用户代码移动到工程根目录下的 /rtl 文件夹中
# ==============================================================================
# 1. 设置目标目录名称 (默认: rtl)
set target_folder_name "rtl"
# 获取当前工程路径
set proj_dir [get_property DIRECTORY [current_project]]
set new_src_dir [file join $proj_dir $target_folder_name]
puts "--------------------------------------------------------"
puts "【步骤 1】正在创建标准目录: $new_src_dir"
# 如果目录不存在则创建
if {![file exists $new_src_dir]} {
    file mkdir $new_src_dir
    puts " -> 目录已创建。"
} else {
    puts " -> 目录已存在，将合并文件到此目录。"
}
puts "--------------------------------------------------------"
puts "【步骤 2】开始扫描并移动源文件..."
# 获取所有 Design Sources (排除仿真文件和约束文件)
# 这里的过滤条件是：在 sources_1 集合中
set files [get_files -of_objects [get_filesets sources_1]]
set move_count 0
foreach f $files {
    # 获取文件名和扩展名
    set fname [file tail $f]
    set fext [file extension $fname]
    
    # --- 过滤器：只处理用户代码 ---
    # 排除 Xilinx IP (.xci), Block Design (.bd), 此时也不处理 .xdc
    if {$fext == ".xci" || $fext == ".bd" || $fext == ".xdc" || $fext == ".dcp"} {
        continue
    }
    
    # 排除已经在目标目录下的文件
    set f_normalized [file normalize $f]
    set new_src_dir_normalized [file normalize $new_src_dir]
    if {[string first $new_src_dir_normalized $f_normalized] != -1} {
        continue
    }

    # --- 执行移动逻辑 ---
    set new_file_path [file join $new_src_dir $fname]
    
    puts " -> 处理: $fname"
    
    # A. 物理复制文件
    # 使用 -force 覆盖旧文件（如果有）
    if {[catch {file copy -force $f $new_file_path} err]} {
        puts "    [错误] 无法复制文件: $err"
        continue
    }
    
    # B. 从工程中移除旧引用
    remove_files $f
    
    # C. 添加新文件引用
    # -norecurse: 不递归扫描子目录
    # -scan_for_includes: 扫描头文件包含
    add_files -norecurse -scan_for_includes $new_file_path
    
    incr move_count
}
puts "--------------------------------------------------------"
if {$move_count > 0} {
    puts "【完成】成功重构 $move_count 个文件！"
    puts "所有代码现已位于: $new_src_dir"
    puts "注意：原来的深层文件夹（imports/...）依然保留在硬盘上，"
    puts "确认新结构无误后，你可以手动删除它们以清理空间。"
} else {
    puts "【提示】没有发现需要移动的文件（可能文件已经在 rtl 目录中，或全是 IP 核）。"
}
puts "--------------------------------------------------------"
# 自动更新编译顺序
update_compile_order -fileset sources_1

# ==============================================================================
# Vivado 双顶层并行编译脚本 (TX + RX)
# 功能：自动创建独立运行 -> 并行编译 -> 自动导出 Bitstream
# ==============================================================================
# 1. 配置参数
set tx_top "fec_tx_fpga_top"
set rx_top "fec_rx_fpga_top"
set jobs_cnt 8  ;# 根据你的CPU核心数调整，建议 8 或 12
puts "--------------------------------------------------------"
puts " 开始配置双顶层并行编译环境..."
puts " TX Top: $tx_top"
puts " RX Top: $rx_top"
puts "--------------------------------------------------------"
# 获取默认的 run 配置作为模板 (通常是 synth_1 和 impl_1)
set base_synth "synth_1"
set base_impl  "impl_1"
set flow_synth [get_property FLOW [get_runs $base_synth]]
set flow_impl  [get_property FLOW [get_runs $base_impl]]
set part_name  [get_property PART [current_project]]
# ==============================================================================
# 函数：创建或获取 Run
# ==============================================================================
proc prepare_run {run_prefix top_module base_s base_i flow_s flow_i part} {
    set s_run "synth_${run_prefix}"
    set i_run "impl_${run_prefix}"

    # 1. 准备综合 Run
    if {[get_runs -quiet $s_run] == ""} {
        puts " -> 创建综合 Run: $s_run"
        create_run $s_run -flow $flow_s -part $part
    }
    # 强制指定该 Run 的顶层模块 (关键步骤)
    set_property TOP $top_module [get_runs $s_run]
    
    # 2. 准备实现 Run
    if {[get_runs -quiet $i_run] == ""} {
        puts " -> 创建实现 Run: $i_run"
        create_run $i_run -parent_run $s_run -flow $flow_i -part $part
    }
    
    return $i_run
}
# ==============================================================================
# 2. 准备 TX 和 RX 的运行环境
# ==============================================================================
set tx_impl_run [prepare_run "tx" $tx_top $base_synth $base_impl $flow_synth $flow_impl $part_name]
# ==============================================================================
# Vivado 双顶层并行编译脚本 (修正版)
# 功能：利用"切换-发射"机制实现并行编译
# ==============================================================================
# 1. 配置参数
set tx_top "fec_tx_fpga_top"
set rx_top "fec_rx_fpga_top"
set jobs_cnt 8  ;# 根据 CPU 核心数调整
puts "--------------------------------------------------------"
puts " 开始配置双顶层并行编译环境 (Switch-and-Launch 模式)..."
puts "--------------------------------------------------------"
# 获取基础配置
set base_synth "synth_1"
set base_impl  "impl_1"
set flow_synth [get_property FLOW [get_runs $base_synth]]
set flow_impl  [get_property FLOW [get_runs $base_impl]]
set part_name  [get_property PART [current_project]]
# ==============================================================================
# 函数：准备 Run (不设置 TOP，只创建对象)
# ==============================================================================
proc prepare_run_obj {run_prefix base_s base_i flow_s flow_i part} {
    set s_run "synth_${run_prefix}"
    set i_run "impl_${run_prefix}"

    if {[get_runs -quiet $s_run] == ""} {
        puts " -> 创建综合 Run: $s_run"
        create_run $s_run -flow $flow_s -part $part
    }
    
    if {[get_runs -quiet $i_run] == ""} {
        puts " -> 创建实现 Run: $i_run"
        create_run $i_run -parent_run $s_run -flow $flow_i -part $part
    }
    return $i_run
}
# 1. 准备运行对象
set tx_impl_run [prepare_run_obj "tx" $base_synth $base_impl $flow_synth $flow_impl $part_name]
set rx_impl_run [prepare_run_obj "rx" $base_synth $base_impl $flow_synth $flow_impl $part_name]
# ==============================================================================
# 2. 发射 TX 任务
# ==============================================================================
puts "--------------------------------------------------------"
puts " [1/2] 正在配置并启动 TX 任务..."
# A. 切换全局 Top 为 TX
set_property top $tx_top [current_fileset]
update_compile_order -fileset sources_1
# B. 重置并启动 TX (生成的脚本将锁定当前的 Top)
reset_run [get_runs -filter "NAME =~ *tx*"]
launch_runs $tx_impl_run -to_step write_bitstream -jobs $jobs_cnt
puts " -> TX 任务已在后台启动。"
# ==============================================================================
# 3. 发射 RX 任务
# ==============================================================================
puts "--------------------------------------------------------"
puts " [2/2] 正在配置并启动 RX 任务..."
# A. 切换全局 Top 为 RX
set_property top $rx_top [current_fileset]
update_compile_order -fileset sources_1
# B. 重置并启动 RX (生成的脚本将锁定当前的 Top)
reset_run [get_runs -filter "NAME =~ *rx*"]
launch_runs $rx_impl_run -to_step write_bitstream -jobs $jobs_cnt
puts " -> RX 任务已在后台启动。"
# ==============================================================================
# 4. 等待结果并导出
# ==============================================================================
puts "--------------------------------------------------------"
puts " 双任务并行编译中，脚本将挂起等待结果 (请勿关闭 Vivado)..."
# 等待两个运行完成
wait_on_run $tx_impl_run
puts "--- 正在修复 IP 核状态 ---"
# 1. 重置 fifo_0 的生成状态
reset_target all [get_ips fifo_0]
# 2. 重新生成 fifo_0 的所有输出文件 (Verilog wrapper 等)
generate_target all [get_ips fifo_0]
# 3. (关键) 导出 IP 用户文件，确保仿真和综合能找到它
export_ip_user_files -of_objects [get_ips fifo_0] -no_script -sync -force -quiet
# 4. 创建 IP 的独立综合任务 (Out-of-Context Run) 并等待它完成
# 这一步是为了确保 IP 自己先编译通过，再编译顶层
create_ip_run [get_ips fifo_0]
launch_runs [get_runs fifo_0_synth_1]
wait_on_run fifo_0_synth_1
puts "--- IP 核修复完成，准备重新综合顶层 ---"
# ==============================================================================
# Vivado 双顶层并行编译脚本 (修正版)
# 功能：利用"切换-发射"机制实现并行编译
# ==============================================================================
# 1. 配置参数
set tx_top "fec_tx_fpga_top"
set rx_top "fec_rx_fpga_top"
set jobs_cnt 8  ;# 根据 CPU 核心数调整
puts "--------------------------------------------------------"
puts " 开始配置双顶层并行编译环境 (Switch-and-Launch 模式)..."
puts "--------------------------------------------------------"
# 获取基础配置
set base_synth "synth_1"
set base_impl  "impl_1"
set flow_synth [get_property FLOW [get_runs $base_synth]]
set flow_impl  [get_property FLOW [get_runs $base_impl]]
set part_name  [get_property PART [current_project]]
# ==============================================================================
# 函数：准备 Run (不设置 TOP，只创建对象)
# ==============================================================================
proc prepare_run_obj {run_prefix base_s base_i flow_s flow_i part} {
    set s_run "synth_${run_prefix}"
    set i_run "impl_${run_prefix}"

    if {[get_runs -quiet $s_run] == ""} {
        puts " -> 创建综合 Run: $s_run"
        create_run $s_run -flow $flow_s -part $part
    }
    
    if {[get_runs -quiet $i_run] == ""} {
        puts " -> 创建实现 Run: $i_run"
        create_run $i_run -parent_run $s_run -flow $flow_i -part $part
    }
    return $i_run
}
# 1. 准备运行对象
set tx_impl_run [prepare_run_obj "tx" $base_synth $base_impl $flow_synth $flow_impl $part_name]
set rx_impl_run [prepare_run_obj "rx" $base_synth $base_impl $flow_synth $flow_impl $part_name]
# ==============================================================================
# 2. 发射 TX 任务
# ==============================================================================
puts "--------------------------------------------------------"
puts " [1/2] 正在配置并启动 TX 任务..."
# A. 切换全局 Top 为 TX
set_property top $tx_top [current_fileset]
update_compile_order -fileset sources_1
# B. 重置并启动 TX (生成的脚本将锁定当前的 Top)
reset_run [get_runs -filter "NAME =~ *tx*"]
launch_runs $tx_impl_run -to_step write_bitstream -jobs $jobs_cnt
puts " -> TX 任务已在后台启动。"
# ==============================================================================
# 3. 发射 RX 任务
# ==============================================================================
puts "--------------------------------------------------------"
puts " [2/2] 正在配置并启动 RX 任务..."
# A. 切换全局 Top 为 RX
set_property top $rx_top [current_fileset]
update_compile_order -fileset sources_1
# B. 重置并启动 RX (生成的脚本将锁定当前的 Top)
reset_run [get_runs -filter "NAME =~ *rx*"]
launch_runs $rx_impl_run -to_step write_bitstream -jobs $jobs_cnt
puts " -> RX 任务已在后台启动。"
# ==============================================================================
# 4. 等待结果并导出
# ==============================================================================
puts "--------------------------------------------------------"
puts " 双任务并行编译中，脚本将挂起等待结果 (请勿关闭 Vivado)..."
# 等待两个运行完成
wait_on_run $tx_impl_run
puts "========================================================"
puts "   开始全量修复 IP 核 (防止 missing module 报错)"
puts "========================================================"
# 1. 获取所有 IP 对象
set all_ips [get_ips *]
if {$all_ips == ""} {
    puts " [提示] 工程中没有发现 IP 核，无需修复。"
} else {
    foreach ip $all_ips {
        puts " -> 正在处理 IP: $ip ..."
        
        # 2. 重置 IP 状态 (清除旧的关联)
        reset_target all $ip
        
        # 3. 锁定 IP 属性以防止意外改动 (可选)
        set_property -quiet GENERATE_SYNTH_CHECKPOINT 1 $ip
        
        # 4. 重新生成所有输出产物 (Instantiation Template, Synthesis, Simulation)
        generate_target all $ip
        
        # 5. 导出用户文件 (确保仿真和综合能索引到 wrapper)
        export_ip_user_files -of_objects $ip -no_script -sync -force -quiet
    }
    
    puts "--------------------------------------------------------"
    puts " 正在为所有 IP 启动独立综合 (Out-of-Context Synthesis)..."
    puts " 这一步可能需要几分钟，请耐心等待..."
    
    # 6. 为所有 IP 创建并启动综合任务
    create_ip_run $all_ips
    
    # 获取所有 IP 的综合 runs
    set ip_runs [get_runs -filter {IS_IP_RUN == 1 && STATUS != "Complete"}]
    
    if {$ip_runs != ""} {
        launch_runs $ip_runs -jobs 8
        foreach run $ip_runs {
            wait_on_run $run
        }
    }
}
puts "========================================================"
puts "   开始全量修复 IP 核 (逐个处理模式)"
puts "========================================================"
# 1. 获取所有 IP 对象
set all_ips [get_ips *]
set runs_to_launch {}
if {$all_ips == ""} {
    puts " [提示] 工程中没有发现 IP 核，无需修复。"
} else {
    foreach ip $all_ips {
        puts " -> [1/3] 处理 IP: $ip ..."
        
        # A. 重置 IP 状态
        reset_target all $ip
        
        # B. 重新生成输出产物
        generate_target all $ip
        
        # C. 导出用户文件
        export_ip_user_files -of_objects $ip -no_script -sync -force -quiet
        
        # D. ★关键修改★：逐个创建综合任务 (避免 collection error)
        # 先检查该 IP 是否已经有对应的 run，没有才创建
        set ip_run_name "${ip}_synth_1"
        if {[get_runs -quiet $ip_run_name] == ""} {
            puts "    - 创建综合任务: $ip_run_name"
            create_ip_run [get_ips $ip]
        } else {
            # 如果任务已存在但状态不对，重置它
            if {[get_property STATUS [get_runs $ip_run_name]] != "Complete"} {
                reset_run [get_runs $ip_run_name]
            }
        }
        
        # 收集需要启动的 run
        lappend runs_to_launch [get_runs $ip_run_name]
    }
    
    puts "--------------------------------------------------------"
    puts " -> [2/3] 正在启动所有 IP 的综合任务..."
    
    # 过滤掉不存在或不需要跑的 run
    set valid_runs {}
    foreach r $runs_to_launch {
        if {$r != "" && [get_property STATUS $r] != "Complete"} {
            lappend valid_runs $r
        }
    }

    if {$valid_runs != ""} {
        # 并行启动所有 IP 综合
        launch_runs $valid_runs -jobs 8
        
        puts " -> [3/3] 等待 IP 综合完成..."
        foreach run $valid_runs {
            wait_on_run $run
        }
    } else {
        puts " -> 所有 IP 看起来都已经是最新的 (Complete)，无需重新综合。"
    }
}
puts "========================================================"
puts "   所有 IP 核修复完成！"
puts "   请再次尝试运行双顶层并行编译脚本。"
puts "========================================================"
# ==============================================================================
# Vivado 双顶层并行编译脚本 (修正版)
# 功能：利用"切换-发射"机制实现并行编译
# ==============================================================================
# 1. 配置参数
set tx_top "fec_tx_fpga_top"
set rx_top "fec_rx_fpga_top"
set jobs_cnt 8  ;# 根据 CPU 核心数调整
puts "--------------------------------------------------------"
puts " 开始配置双顶层并行编译环境 (Switch-and-Launch 模式)..."
puts "--------------------------------------------------------"
# 获取基础配置
set base_synth "synth_1"
set base_impl  "impl_1"
set flow_synth [get_property FLOW [get_runs $base_synth]]
set flow_impl  [get_property FLOW [get_runs $base_impl]]
set part_name  [get_property PART [current_project]]
# ==============================================================================
# 函数：准备 Run (不设置 TOP，只创建对象)
# ==============================================================================
proc prepare_run_obj {run_prefix base_s base_i flow_s flow_i part} {
    set s_run "synth_${run_prefix}"
    set i_run "impl_${run_prefix}"

    if {[get_runs -quiet $s_run] == ""} {
        puts " -> 创建综合 Run: $s_run"
        create_run $s_run -flow $flow_s -part $part
    }
    
    if {[get_runs -quiet $i_run] == ""} {
        puts " -> 创建实现 Run: $i_run"
        create_run $i_run -parent_run $s_run -flow $flow_i -part $part
    }
    return $i_run
}
# 1. 准备运行对象
set tx_impl_run [prepare_run_obj "tx" $base_synth $base_impl $flow_synth $flow_impl $part_name]
set rx_impl_run [prepare_run_obj "rx" $base_synth $base_impl $flow_synth $flow_impl $part_name]
# ==============================================================================
# 2. 发射 TX 任务
# ==============================================================================
puts "--------------------------------------------------------"
puts " [1/2] 正在配置并启动 TX 任务..."
# A. 切换全局 Top 为 TX
set_property top $tx_top [current_fileset]
update_compile_order -fileset sources_1
# B. 重置并启动 TX (生成的脚本将锁定当前的 Top)
reset_run [get_runs -filter "NAME =~ *tx*"]
launch_runs $tx_impl_run -to_step write_bitstream -jobs $jobs_cnt
puts " -> TX 任务已在后台启动。"
# ==============================================================================
# 3. 发射 RX 任务
# ==============================================================================
puts "--------------------------------------------------------"
puts " [2/2] 正在配置并启动 RX 任务..."
# A. 切换全局 Top 为 RX
set_property top $rx_top [current_fileset]
update_compile_order -fileset sources_1
# B. 重置并启动 RX (生成的脚本将锁定当前的 Top)
reset_run [get_runs -filter "NAME =~ *rx*"]
launch_runs $rx_impl_run -to_step write_bitstream -jobs $jobs_cnt
puts " -> RX 任务已在后台启动。"
# ==============================================================================
# 4. 等待结果并导出
# ==============================================================================
puts "--------------------------------------------------------"
puts " 双任务并行编译中，脚本将挂起等待结果 (请勿关闭 Vivado)..."
# 等待两个运行完成
wait_on_run $tx_impl_run
wait_on_run $rx_impl_run
puts "--------------------------------------------------------"
puts " 编译结束！开始导出 Bitstream..."
# 定义导出函数
proc export_bit {impl_run target_name} {
    set run_dir [get_property DIRECTORY [get_runs $impl_run]]
    set bit_files [glob -nocomplain -directory $run_dir *.bit]
    
    if {$bit_files != ""} {
        set src_bit [lindex $bit_files 0]
        set dst_bit "[pwd]/$target_name"
        file copy -force $src_bit $dst_bit
        puts " [成功] 已导出: $target_name"
    } else {
        puts " [失败] 在 $impl_run 中未找到 .bit 文件。"
    }
}
export_bit $tx_impl_run "tx_top.bit"
# 1. 找到 RX 的运行目录
set rx_dir [get_property DIRECTORY [get_runs impl_rx]]
# 2. 复制并改名 (自动找到里面的 .bit 文件)
file copy -force [glob -directory $rx_dir *.bit] ./rx_top.bit
puts "RX Bitstream 已补救导出！"
set_property is_global_include false [get_files  C:/Users/PC/Desktop/fec_verf/prj/fec_lasercom/rtl/rs_Deinterleaver_xpm.v]
update_compile_order -fileset sources_1
